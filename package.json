{
  "name": "brahmi-abbes-portfolio",
  "version": "1.0.0",
  "description": "Static personal portfolio — HTML/Tailwind/vanilla JS",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.css --minify",
    "build:js": "terser js/script.js -o js/script.min.js --compress --mangle",
    "compile:all": "npm run build:css && npm run build:js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19",
    "terser": "^5.49.0"
  }
}